; Terjemahan bahasa Indonesia untuk pesan Inno Setup yang tampil pada installer CostStruct.
; Dipakai di atas compiler:Default.isl (lihat [Languages] di CostStruct.iss): pesan yang tidak diterjemahkan di sini
; tetap memakai teks bawaan. Ditulis tanpa karakter non-ASCII agar aman untuk semua code page.

[LangOptions]
LanguageName=Bahasa Indonesia
LanguageID=$0421

[Messages]
SetupAppTitle=Instalasi
SetupWindowTitle=Instalasi - %1
UninstallAppTitle=Hapus Instalasi
UninstallAppFullTitle=Hapus Instalasi %1

ButtonBack=< &Kembali
ButtonNext=&Lanjut >
ButtonInstall=&Pasang
ButtonOK=OK
ButtonCancel=Batal
ButtonYes=&Ya
ButtonYesToAll=Ya untuk &Semua
ButtonNo=&Tidak
ButtonNoToAll=T&idak untuk Semua
ButtonFinish=&Selesai
ButtonBrowse=&Telusuri...
ButtonWizardBrowse=T&elusuri...
ButtonNewFolder=&Buat Folder Baru

ExitSetupTitle=Keluar dari Instalasi
ExitSetupMessage=Instalasi belum selesai. Bila keluar sekarang, aplikasi tidak akan terpasang.%n%nInstalasi dapat dijalankan lagi kapan saja.%n%nKeluar dari Instalasi?

PrivilegesRequiredOverrideTitle=Pilih Mode Instalasi
PrivilegesRequiredOverrideInstruction=Pilih mode instalasi
PrivilegesRequiredOverrideText1=%1 dapat dipasang untuk semua pengguna (memerlukan hak administrator), atau hanya untuk Anda.
PrivilegesRequiredOverrideText2=%1 dapat dipasang hanya untuk Anda, atau untuk semua pengguna (memerlukan hak administrator).
PrivilegesRequiredOverrideAllUsers=Pasang untuk &semua pengguna
PrivilegesRequiredOverrideAllUsersRecommended=Pasang untuk &semua pengguna (disarankan)
PrivilegesRequiredOverrideCurrentUser=Pasang hanya untuk &saya
PrivilegesRequiredOverrideCurrentUserRecommended=Pasang hanya untuk &saya (disarankan)

WelcomeLabel1=Selamat datang di Instalasi [name]
WelcomeLabel2=Program ini akan memasang [name/ver] di komputer Anda.%n%nTutup aplikasi lain sebelum melanjutkan.

WizardSelectDir=Pilih Lokasi Tujuan
SelectDirDesc=Di mana [name] akan dipasang?
SelectDirLabel3=Instalasi akan memasang [name] ke folder berikut.
SelectDirBrowseLabel=Klik Lanjut untuk melanjutkan. Untuk memilih folder lain, klik Telusuri.

WizardSelectTasks=Pilih Tugas Tambahan
SelectTasksDesc=Tugas tambahan apa yang ingin dijalankan?
SelectTasksLabel2=Pilih tugas tambahan yang diinginkan saat memasang [name], lalu klik Lanjut.

WizardReady=Siap Memasang
ReadyLabel1=Instalasi siap memasang [name] di komputer Anda.
ReadyLabel2a=Klik Pasang untuk melanjutkan, atau klik Kembali untuk meninjau atau mengubah pengaturan.
ReadyLabel2b=Klik Pasang untuk melanjutkan.
ReadyMemoDir=Lokasi tujuan:
ReadyMemoTasks=Tugas tambahan:

WizardInstalling=Memasang
InstallingLabel=Tunggu sebentar, Instalasi sedang memasang [name] di komputer Anda.

FinishedHeadingLabel=Instalasi [name] selesai
FinishedLabelNoIcons=Instalasi telah selesai memasang [name] di komputer Anda.
FinishedLabel=Instalasi telah selesai memasang [name] di komputer Anda. Aplikasi dapat dibuka dari shortcut yang dipasang.
ClickFinish=Klik Selesai untuk menutup Instalasi.

ConfirmUninstall=Hapus %1 dari komputer ini? Data proyek dan harga satuan di folder data pengguna tidak ikut dihapus.
UninstalledAll=%1 berhasil dihapus dari komputer Anda.
WizardUninstalling=Status Penghapusan
StatusUninstalling=Menghapus %1...

[CustomMessages]
CreateDesktopIcon=Buat shortcut di &desktop
AdditionalIcons=Shortcut tambahan:
LaunchProgram=Jalankan %1
AsosiasiFile=Asosiasi file:
AsosiasiProyek=Buka file proyek .coststruct dengan CostStruct (klik dua kali di Explorer)
AsosiasiIFC=Tambahkan CostStruct ke menu "Buka dengan" untuk file .ifc
JenisFileProyek=File Proyek CostStruct
